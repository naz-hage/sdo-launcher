<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Reference: https://learn.microsoft.com/en-us/visualstudio/msbuild/walkthrough-using-msbuild?view=vs-2022 -->
	
	<Import Project="$(ProgramFiles)\sdo\common.targets"/>

	<PropertyGroup>
        <!-- This is the folder where the *.sln resides-->
		<CurrentDirectory>$(MSBuildProjectDirectory)</CurrentDirectory>
		
		<SolutionName>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectDirectory)'))</SolutionName>
        <!-- This is the location when the app deployed or installed -->

		<NugetPackagePath>$(ArtifactsDir)\$(SolutionName)\Nuget\$(ProductVersion)</NugetPackagePath>
		<LocalNugetFeed>$(ArtifactsDir)\nupkgs</LocalNugetFeed>

		<DeploymentFolder>$(LocalNugetFeed)</DeploymentFolder>
	</PropertyGroup>
	
	<!-- Define current solution folder -->
	<Target Name="CURRENT_DIRECTORY" >

		<PropertyGroup>
			<CurrentDirectory>$(MSBuildProjectDirectory)</CurrentDirectory>
		</PropertyGroup>
		
		<PropertyGroup>
			<DirectoryName>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectDirectory)'))</DirectoryName>
		</PropertyGroup>
		<Message Text="Directory Name: $(DirectoryName)"/>
	</Target>

	<!--Setup the ARTIFACTS folders for binaries and test results - override -->
    <Target Name="ARTIFACTS" DependsOnTargets="TAG">
      <PropertyGroup>
        <ArtifactsFolder>$(ArtifactsDir)\$(SolutionName)\$(TargetRelease)\$(ProductVersion)</ArtifactsFolder>
		<ArtifactsTestResultsFolder>$(ArtifactsDir)\$(SolutionName)\TestResults\$(ProductVersion)</ArtifactsTestResultsFolder>
      </PropertyGroup>  
      <ItemGroup>
            <BinaryFiles 
						Exclude="
       $(SolutionDir)\$(TargetRelease)\**\*.pdb;
       $(SolutionDir)\$(TargetRelease)\test.*;
       $(SolutionDir)\$(TargetRelease)\*test*;
       $(SolutionDir)\$(TargetRelease)\Nuget*;
       $(SolutionDir)\$(TargetRelease)\*CodeCoverage*"

						Include="
                        $(SolutionDir)\$(TargetRelease)\*.exe;
                        $(SolutionDir)\$(TargetRelease)\*.exe.config;
                        $(SolutionDir)\$(TargetRelease)\*.json;
						$(SolutionDir)\sdo\resources\*.targets;
						$(SolutionDir)\sdo\resources\*.ps1;
                        $(SolutionDir)\$(TargetRelease)\*.dll"
						/>

            <RunTimesNetStandard20 Include = "
           $(SolutionDir)\$(TargetRelease)\netstandard2.0\*.*"
                                    Exclude="
                  $(SolutionDir)\$(TargetRelease)\**\*.pdb"
                  />
    
        </ItemGroup>
		
        <Message Text="==> DONE"/>
    </Target>

	<!-- Define Nuget Package dependencies -->
	<Target Name="NUGET_DEP" DependsOnTargets="TAG">
	<PropertyGroup>
		<NugetPackagePath>$(ArtifactsDir)\$(SolutionName)\Nuget\$(ProductVersion)</NugetPackagePath>
		<LocalNugetFeed>$(ArtifactsDir)\nupkgs</LocalNugetFeed>
	</PropertyGroup>
	</Target>

	<!-- Pack a Nuget package -->
	<Target Name="NUGET_PACK" DependsOnTargets="NUGET_DEP">
		<Exec Command='"$(NugetExe)" pack "$(SolutionDir)\launcher\sdo-launcher.nuspec" -Version $(ProductVersion) -OutputDirectory "$(NugetPackagePath)"'/>
        <Exec Command='if exist "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" rd "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" /s /q'/>

		<Message Text="==> DONE"/>
		</Target>

	<!-- Pack and Add Nuget package to local feed after a stage build -->
	<Target Name="NUGET_ADD" DependsOnTargets="AUTOTAG_STAGE;SOLUTION;NUGET_DEP;NUGET_PACK" AfterTargets="STAGE">
		<Exec Command='if exist "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" rd "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" /s /q'/>
		<Exec Command='"$(NugetExe)" add "$(NugetPackagePath)\sdo-launcher.$(ProductVersion).nupkg" -Source "$(LocalNugetFeed)"'/>

		<Message Text="==> DONE"/>
	</Target>
	
	<!-- Create and Publish a Nuget package to the public feed after a prod build -->
	<Target Name="NUGET_PUBLISH" DependsOnTargets="NUGET_DEP;NUGET_PACK" AfterTargets="PROD">
		<PropertyGroup>
			<NugetApiKey>$(NugetApiKey)</NugetApiKey>
		</PropertyGroup>
		<Message Text="Publishing Nuget package with version $(ProductVersion)" />
		<Exec Command='"$(NugetExe)" push "$(NugetPackagePath)\sdo-launcher.$(ProductVersion).nupkg" -Source https://api.nuget.org/v3/index.json -ApiKey $(NugetApiKey)'/>
		<Message Text="==> DONE"/>	
	</Target>

	<!-- Build docs locally for testing -->
	<Target Name="MKDOCS" >
		<Exec Command='pip install mkdocs' WorkingDirectory="$(SolutionDir)"/>
		<Exec Command='python -m mkdocs build -d %userprofile%\sdo' WorkingDirectory="$(SolutionDir)"/>
		<Exec Command='python -m mkdocs serve' WorkingDirectory="$(SolutionDir)"/>
     <Message Text="==> DONE"/>
	</Target>

  <!-- Create a production Nuget package and release - override -->
  <Target Name="PROD" DependsOnTargets="
                CLEAN;
                GIT_PULL;
                TAG;
                AUTOTAG_PROD;
                SOLUTION;
				TEST;
                COPY_ARTIFACTS;
                PACKAGE">
  </Target>

  <!-- Build the solution alias solution target -->
  <Target Name="BUILD" >
	<CallTarget Targets="solution" />
  </Target>
</Project>
