<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Reference: https://learn.microsoft.com/en-us/visualstudio/msbuild/walkthrough-using-msbuild?view=vs-2022 -->
	
	<Import Project="$(ProgramFiles)\sdo\common.targets"/>

	<PropertyGroup>
        <!-- This is the folder where the *.sln resides-->
		<CurrentDirectory>$(MSBuildProjectDirectory)</CurrentDirectory>
		
		<SolutionName>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectDirectory)'))</SolutionName>
        <!-- This is the location when the app deployed or installed -->

		<NugetPackagePath>$(ArtifactsDir)\$(SolutionName)\Nuget\$(ProductVersion)</NugetPackagePath>
		<LocalNugetFeed>$(ArtifactsDir)\nupkgs</LocalNugetFeed>

		<DeploymentFolder>$(LocalNugetFeed)</DeploymentFolder>
	</PropertyGroup>
	
	<!-- Define Nuget Package dependencies -->
	<Target Name="NUGET_DEP" DependsOnTargets="TAG">
	<PropertyGroup>
		<NugetPackagePath>$(ArtifactsDir)\$(SolutionName)\Nuget\$(ProductVersion)</NugetPackagePath>
		<LocalNugetFeed>$(ArtifactsDir)\nupkgs</LocalNugetFeed>
	</PropertyGroup>
	</Target>

	<!-- Pack a Nuget package -->
	<Target Name="NUGET_PACK" DependsOnTargets="NUGET_DEP">
		<Exec Command='"dotnet" pack "$(SolutionDir)\launcher\Launcher.csproj" --configuration "$(TargetRelease)" --output "$(NugetPackagePath)" --no-restore -p:PackageVersion=$(ProductVersion)'/>
        <Exec Command='if exist "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" rd "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" /s /q'/>

		<Message Text="==> DONE"/>
		</Target>

	<!-- Pack and Add Nuget package to local feed after a stage build -->
	<Target Name="NUGET_ADD" DependsOnTargets="AUTOTAG_STAGE;SOLUTION;NUGET_DEP;NUGET_PACK" AfterTargets="STAGE">
		<Exec Command='if exist "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" rd "$(LocalNugetFeed)\sdo-launcher\$(ProductVersion)" /s /q'/>
		<Exec Command='"dotnet" nuget push "$(NugetPackagePath)\sdo-launcher.$(ProductVersion).nupkg" --source "$(LocalNugetFeed)" --skip-duplicate'/>

		<Message Text="==> DONE"/>
	</Target>
	
	<!-- Create and Publish a Nuget package to the public feed after a prod build -->
	<Target Name="NUGET_PUBLISH" DependsOnTargets="NUGET_DEP;NUGET_PACK" AfterTargets="PROD">
		<PropertyGroup>
			<NugetApiKey>$(NugetApiKey)</NugetApiKey>
		</PropertyGroup>
		<Message Text="Publishing Nuget package with version $(ProductVersion)" />
		<Exec Command='"dotnet" nuget push "$(NugetPackagePath)\sdo-launcher.$(ProductVersion).nupkg" --source https://api.nuget.org/v3/index.json --api-key "$(NugetApiKey)"'/>
		<Message Text="==> DONE"/>	
	</Target>

	<!-- Build docs locally for testing -->
	<Target Name="MKDOCS" >
		<Exec Command='pip install mkdocs' WorkingDirectory="$(SolutionDir)"/>
		<Exec Command='python -m mkdocs build -d %userprofile%\sdo' WorkingDirectory="$(SolutionDir)"/>
		<Exec Command='python -m mkdocs serve' WorkingDirectory="$(SolutionDir)"/>
     <Message Text="==> DONE"/>
	</Target>
</Project>
